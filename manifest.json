{
  "manifest_version": 3,
  "name": "豆瓣随机",
  "version": "0.4.17",
  "description": "少一点选择，多一点开始。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*.douban.com/*",
    "https://*.doubanio.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "images",
        "enabled": true,
        "path": "src/rules/images.json"
      }
    ]
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.douban.com/*"
      ],
      "js": [
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "action": {
    "default_title": "豆瓣随机",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
